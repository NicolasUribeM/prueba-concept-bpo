# =============================================================================
#  Variables de entorno del backend (plantilla).
#  Copiar este archivo como ".env" y ajustar si es necesario.
#  El .env real NO se sube al repositorio (ver .gitignore).
# =============================================================================

# --- Servidor ---
PORT=4000

# --- Base de datos MySQL (coincide con docker-compose.yml) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_pass
DB_NAME=multitenant_db

# --- Seguridad JWT ---
# En producción debe ser un secreto largo y aleatorio guardado de forma segura.
JWT_SECRET=clave_secreta_super_segura_para_la_prueba_concept_bpo
JWT_EXPIRES_IN=1h
